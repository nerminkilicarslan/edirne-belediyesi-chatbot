# ─────────────────────────────────────────────────────────────────────────────
# Edirne Belediye Chatbot — Ortam Değişkenleri
# Bu dosyayı kopyalayın: cp .env.example app/.env
# ─────────────────────────────────────────────────────────────────────────────

# ── Uygulama ─────────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=false

# ── Ollama LLM ────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=120
OLLAMA_TEMPERATURE=0.1
OLLAMA_CONTEXT_WINDOW=4096

# ── Embeddings ────────────────────────────────────────────────────────────────
# Apple M-serisi için "mps", NVIDIA için "cuda", CPU için "cpu", otomatik için "auto"
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DEVICE=auto

# ── ChromaDB ─────────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIRECTORY=./data/chroma_db
CHROMA_COLLECTION_NAME=edirne_kb

# ── Retrieval Ayarları ────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.28
BM25_WEIGHT=0.30
SEMANTIC_WEIGHT=0.70

# ── Güvenlik ────────────────────────────────────
# API_KEY=gizli-anahtar-burada
# CORS_ORIGINS=["https://edirne.bel.tr"]
